---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/content';
import { SITE } from '../site.config';

const home = await getEntry('pages', 'index');
if (!home || home.data.draft) throw new Error('Нужен src/content/pages/index.md (главная страница)');
const { Content } = await render(home);
const latest = (await getPosts()).slice(0, SITE.homePosts);
const { title, description, image } = home.data;
---

<Base title={SITE.name} description={description}>
  <div class="panel">
    <section class="intro">
      <h1>{title}</h1>
      {image && <Cover src={image} eager class="hero" />}
      <div class="prose"><Content /></div>
    </section>

    {
      latest.length > 0 && (
        <section class="latest" aria-labelledby="latest">
          <h2 id="latest">Последние новости</h2>
          {latest.map((post) => <PostCard post={post} />)}
          <p class="all"><a href="/news/">Все новости →</a></p>
        </section>
      )
    }
  </div>
</Base>

<style>
  :global(.hero) { margin-block: var(--space-4); }
  .latest { margin-top: var(--space-6); padding-top: var(--space-4); border-top: 1px solid var(--color-border); }
  .all { margin: var(--space-3) 0 0; }
</style>
