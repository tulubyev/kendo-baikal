---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Page from '../layouts/Page.astro';
import { getPages, pageCrumbs, type Page as PageEntry } from '../lib/content';

export const getStaticPaths = (async () => {
  const pages = await getPages();
  // index.md — главная, её собирает src/pages/index.astro
  return pages
    .filter((p) => p.id !== 'index')
    .map((entry) => ({ params: { slug: entry.id }, props: { entry, all: pages } }));
}) satisfies GetStaticPaths;

const { entry, all } = Astro.props as { entry: PageEntry; all: PageEntry[] };
const { Content } = await render(entry);
---

<Page title={entry.data.title} description={entry.data.description} image={entry.data.image} crumbs={pageCrumbs(entry, all)}>
  <Content />
</Page>
