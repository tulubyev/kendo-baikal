---
import { SITE } from '../site.config';
const { contacts, social } = SITE;
const links = social.filter((s) => s.url);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap inner">
    <div>
      <p class="name">© 2003–{year} {SITE.name}</p>
      {contacts.address && <p>{contacts.address}</p>}
      {contacts.phone && <p><a href={`tel:${contacts.phone.replace(/[^+\d]/g, '')}`}>{contacts.phone}</a></p>}
      {contacts.email && <p><a href={`mailto:${contacts.email}`}>{contacts.email}</a></p>}
    </div>
    <nav aria-label="Дополнительные ссылки">
      <ul>
        <li><a href="/kak-nas-nayti/">Контакты и расписание</a></li>
        {links.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.title}</a></li>)}
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer { margin-top: var(--space-7); padding-block: var(--space-5); background: var(--color-footer-bg) var(--bg-paper); color: var(--color-footer-text); border-top: 1px solid var(--color-border); font-size: var(--text-sm); }
  .site-footer a { color: var(--color-footer-link); }
  .inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-4) var(--space-6); }
  p { margin: 0 0 var(--space-1); }
  .name { font-weight: var(--font-weight-bold); }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); }
</style>
