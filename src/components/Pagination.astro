---
interface Props {
  current: number;
  total: number;
  /** Адрес страницы по номеру */
  href: (page: number) => string;
}
const { current, total, href } = Astro.props;
// Окно из 5 номеров вокруг текущей: «1 2 3 4 5 » »»» как на старом сайте
const size = Math.min(5, total);
const start = Math.max(1, Math.min(current - 2, total - size + 1));
const pages = Array.from({ length: size }, (_, i) => start + i);
---

{
  total > 1 && (
    <nav class="pagination" aria-label="Страницы ленты">
      <ul>
        {current > 2 && <li><a href={href(1)} aria-label="Первая страница">«</a></li>}
        {current > 1 && <li><a rel="prev" href={href(current - 1)} aria-label="Новее">‹</a></li>}
        {
          pages.map((p) => (
            <li>
              {p === current ? <span aria-current="page" class="cur">{p}</span> : <a href={href(p)} aria-label={`Страница ${p}`}>{p}</a>}
            </li>
          ))
        }
        {current < total && <li><a rel="next" href={href(current + 1)} aria-label="Старее">»</a></li>}
        {current < total - 1 && <li><a href={href(total)} aria-label={`Последняя страница, ${total}`}>»»</a></li>}
      </ul>
    </nav>
  )
}

<style>
  .pagination {
    margin: var(--space-5) calc(-1 * var(--space-4)) calc(-1 * var(--space-4));
    padding: var(--space-1) var(--space-2);
    background: var(--color-ribbon);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }
  @media (min-width: 48em) { .pagination { background: var(--color-ribbon) url('/theme/page.webp') center / 100% 100% no-repeat; margin-inline: calc(-1 * var(--space-5)); margin-bottom: calc(-1 * var(--space-5)); } }
  ul { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-1); list-style: none; margin: 0; padding: 0; }
  a, .cur {
    display: grid; place-items: center; min-width: 2.75rem; height: 2.75rem; padding: 0 var(--space-2);
    border: 1px solid #ddd2b4; border-radius: var(--radius-sm); font-weight: var(--font-weight-bold); text-decoration: none;
  }
  a { color: #6f664d; background: rgb(247 245 239 / 0.6); }
  a:hover { border-color: #b7a97d; color: #2f5a3a; background: #e8dfc2; }
  .cur { border-color: #b7a97d; background: #e2d8bd; color: #2d5a35; }
</style>
