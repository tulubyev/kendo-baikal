---
interface Props {
  current: number;
  total: number;
  /** Адрес страницы по номеру */
  href: (page: number) => string;
}
const { current, total, href } = Astro.props;
const pages = Array.from({ length: total }, (_, i) => i + 1);
---

{
  total > 1 && (
    <nav class="pagination" aria-label="Страницы ленты">
      {current > 1 ? <a rel="prev" href={href(current - 1)}>← Новее</a> : <span class="off">← Новее</span>}
      <ul>
        {pages.map((p) => (
          <li>
            {p === current ? <span aria-current="page" class="cur">{p}</span> : <a href={href(p)}>{p}</a>}
          </li>
        ))}
      </ul>
      {current < total ? <a rel="next" href={href(current + 1)}>Старее →</a> : <span class="off">Старее →</span>}
    </nav>
  )
}

<style>
  .pagination { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; margin-top: var(--space-6); }
  ul { display: flex; gap: var(--space-2); list-style: none; margin: 0; padding: 0; }
  a, .cur, .off { padding: var(--space-2) var(--space-3); border-radius: var(--radius); min-width: 2.75rem; text-align: center; display: inline-block; }
  a { border: 1px solid var(--color-border); text-decoration: none; }
  a:hover { border-color: var(--color-accent); }
  .cur { background: var(--color-accent); color: var(--color-on-accent); font-weight: var(--font-weight-bold); }
  .off { color: var(--color-text-muted); }
</style>
