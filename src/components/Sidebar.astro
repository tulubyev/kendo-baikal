---
import { getPageTree } from '../lib/content';

const tree = await getPageTree();
const path = Astro.url.pathname;
---

<aside class="sidebar" aria-label="Поиск и страницы сайта">
  <form class="search" action="/search/" method="get" role="search">
    <label class="visually-hidden" for="site-search">Поиск по сайту</label>
    <input id="site-search" type="search" name="q" autocomplete="off" required />
    <button type="submit" aria-label="Найти"></button>
  </form>

  <nav aria-labelledby="pages-title">
    <h2 id="pages-title">Страницы</h2>
    <ul>
      <li><a href="/news/" aria-current={path.startsWith('/news/') ? 'page' : undefined}>Новости</a></li>
      {
        tree.map((p) => (
          <li>
            <a href={p.href} aria-current={path === p.href ? 'page' : undefined}>{p.title}</a>
            {p.children.length > 0 && (
              <ul>
                {p.children.map((c) => (
                  <li>
                    <a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.title}</a>
                    {c.children.length > 0 && (
                      <ul>{c.children.map((g) => <li><a href={g.href} aria-current={path === g.href ? 'page' : undefined}>{g.title}</a></li>)}</ul>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </nav>
</aside>

<style>
  .search { display: flex; align-items: center; gap: 0.5rem; height: 60px; padding: 0 0.75rem 0 1rem; background: url('/theme/seach.webp') center / 100% 100% no-repeat; border-radius: var(--radius); }
  .search input {
    flex: 1 1 auto; min-width: 0; height: 2.25rem; padding: 0 0.5rem; font: inherit; font-size: var(--text-sm);
    color: #000; background: #f9f8f5; border: 1px solid #b9b09a; border-radius: var(--radius-sm);
  }
  .search button {
    flex: none; width: 2.5rem; height: 2.5rem; padding: 0; border: 0; cursor: pointer; border-radius: 50%;
    background: url('/theme/seachicon.webp') center / contain no-repeat;
  }
  h2 {
    margin: var(--space-4) 0 var(--space-1); height: 38px; padding-left: 1.4rem;
    background: url('/theme/sidebar.webp') left center / 213px 38px no-repeat;
    color: var(--color-nav-text); font-size: 1rem; font-weight: var(--font-weight-normal); line-height: 42px;
  }
  ul { list-style: none; margin: 0; padding: 0; }
  li { padding: 0.375rem 0 0.25rem 0.8rem; background: url('/theme/sideicon.webp') no-repeat 0 0.9rem; border-bottom: 1px dashed var(--color-dash); line-height: 1.35; }
  li ul { margin: 0.2rem 0 0 0.5rem; }
  li li:last-child { border-bottom: 0; }
  a { display: inline-block; padding-block: 0.1rem; color: #2b2a25; font-size: var(--text-sm); text-decoration: none; }
  a:hover { color: var(--color-accent); text-decoration: underline; }
  a[aria-current='page'] { font-weight: var(--font-weight-bold); color: var(--color-heading); }
</style>
