---
import Cover from './Cover.astro';
import { formatDate, isoDate } from '../lib/date';
import { postUrl, type Post } from '../lib/content';

interface Props { post: Post }
const { post } = Astro.props;
const { title, description, date, category, cover } = post.data;
const href = postUrl(post.id);
---

<article class="item">
  <p class="meta">
    <time datetime={isoDate(date)}>{formatDate(date)}</time>
    {category && <span> · {category}</span>}
  </p>
  <h3><a href={href}>{title}</a></h3>
  {cover && <Cover src={cover} class="thumb" />}
  {description && <p class="desc">{description}</p>}
</article>

<style>
  .item { padding-block: var(--space-4); border-bottom: 1px dashed #8a8371; }
  .item:first-child { padding-top: 0; }
  .item:last-child { border-bottom: 0; }
  .meta { margin: 0 0 var(--space-1); color: var(--color-green); }
  h3 { margin: 0 0 var(--space-2); font-size: var(--text-xl); }
  h3 a { color: var(--color-heading); text-decoration: none; }
  h3 a:hover { color: var(--color-accent); text-decoration: underline; }
  .desc { margin: 0; color: var(--color-text-muted); }
  :global(.thumb) { max-width: 24rem; margin-block: var(--space-2); }
</style>
