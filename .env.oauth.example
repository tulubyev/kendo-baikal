# Шаблон для /var/www/kendo-baikal/.env.oauth на VPS (chmod 600). Значения здесь не хранить!
# Копия на сервере: cp .env.oauth.example .env.oauth && chmod 600 .env.oauth
# Формат: КЛЮЧ=значение, без кавычек и пробелов вокруг «=».

# Из GitHub → Settings → Developer settings → OAuth Apps → ваше приложение
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Случайная строка ≥ 32 байт: openssl rand -hex 32
COOKIE_SECRET=

# Логины GitHub редакторов (и владельца) через запятую, регистр не важен. Пусто = вход запрещён всем.
ALLOWED_USERS=

# Необязательно (по умолчанию https://kendo-baikal.ru):
# PUBLIC_ORIGIN=https://kendo-baikal.ru
